# Copie este arquivo para ".env" e preencha com os seus valores (o .env NUNCA vai para o GitHub)

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=prolicit

# Servidor
PORT=3001
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Origens do front-end liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Limite de tentativas no login/cadastro/recuperação de senha.
# Deixe comentado no uso normal. Use RATE_LIMIT=off só para rodar os testes automatizados.
# RATE_LIMIT=off

# Inteligência artificial (leitura de editais em PDF)
GEMINI_API_KEY=

# E-mail (recuperação de senha). No Gmail, use uma SENHA DE APP (16 letras), não a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=
